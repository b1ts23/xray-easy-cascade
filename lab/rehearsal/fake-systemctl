#!/bin/sh
set -eu

action=${1:-}
unit=${2:-}
unit=${unit%.timer}
unit=${unit%.service}
state=/run/xray-cascade-fake-systemd
pid_file="$state/$unit.pid"
case "$action" in
  stop)
    if [ -s "$pid_file" ]; then
      pid=$(cat "$pid_file")
      kill "$pid" 2>/dev/null || true
      rm -f "$pid_file"
    fi
    ;;
  is-active)
    if [ -s "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
      echo active
      exit 0
    fi
    echo inactive
    exit 3
    ;;
  *) exit 0 ;;
esac
